  "normative_rules": [
    {
      "rule": "Read CMD=0x03 has no OrigData; Read ReqNumBeats=0",
      "source": "Common 2.0 Table 2-12 p57; Table 2-2 p50"
    },
    {
      "rule": "Request Tag width11; no reuse until last response beat; identity per port",
      "source": "Common 2.0 Table 2-2 p49; 2.7.4.2 p52; R078"
    },
    {
      "rule": "Request address width57, low2 bits zero, at most256 bytes and no256-byte boundary crossing; length encodes DWORD count minus1",
      "source": "Common 2.0 Table 2-2 pp49-50; 2.7.4.4-5 p55; 2.8 pp74-75; R080"
    },
    {
      "rule": "Response TAG=request TAG, response DST=request SRC; response SRC is debug only and not functional identity",
      "source": "Common 2.0 Table 2-15 p62; Table 5-30 pp138-139"
    },
    {
      "rule": "RD_WR=1 selects Read; ordinary unicast RSPTYPE=00",
      "source": "Common 2.0 Table 5-30 p139; Table 2-15 p63"
    },
    {
      "rule": "Status0 OKAY and3 DECODE ERROR; ordinary errors still supply all beat data/LAST; error data does not commit successful application data",
      "source": "Common 2.0 2.7.5.1 Table 2-16 pp64-65; R081"
    },
    {
      "rule": "Read data uses natural byte lanes; one64-byte aligned read is one complete response beat",
      "source": "Common 2.0 2.8 pp74-75; R080"
    },
    {
      "rule": "TL POOL choice is independent of UPLI Pool credit",
      "source": "Common 2.0 Tables 5-29/30 pp137-138"
    }
  ],
  "local_rules": [
    "The complete profile above is a bounded bring-up choice, not permission to omit other mandatory protocol behavior.",
    "ASI0/metadata0 are explicit local test-memory choices for implementation-defined semantics.",
    "Emit CLOAD=0, CWAY=0 and response SPARE=0. This decoder projects away response SPARE bits and does not define full receiver unassigned-bit policy.",
    "encode_read returns128-bit field; encode_response returns64-bit field. Neither packs Control padding or DL framing.",
    "Port is local metadata and is not encoded in either field. Initial integrated profile uses port0; identity model permits num_ports1/2/4 for cross-port unit checks.",
    "ReadTracker is a semantic event model: reserve atomically owns a request and512-bit result slot; mark_sent is actual TL Header consumption; receive requires two256-bit halves; retire is application completion acceptance.",
    "Completed results retain capacity and Tag until local application retirement. This is conservative beyond the minimum response-received lifetime.",
    "All exceptions diagnose unsupported or invalid local model events; they do not prescribe wire error codes, TL Drop, Isolation or resets.",
    "Memory service uses explicit immutable byte array; it checks full57-bit address plus64 without truncation. Out-of-range returns status3 and two zero halves.",
    "Only status0 completes with application data; status3 completes with data=None, even though complete response payload must still be present.",
    "Mutating methods validate fully before committing state; errors do not consume capacity or mark completion."
  ],
