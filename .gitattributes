* text=auto eol=lf
*.sh text eol=lf
*.tcl text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Keep large reproducible reports out of normal Git objects.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.zst filter=lfs diff=lfs merge=lfs -text
